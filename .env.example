# Basis-URL des neuen Backends (Intern-Bereich), serverseitig erreichbar, ohne abschließenden Schrägstrich
WEBSITE_API_URL=http://app:3000
# API-Key (Administration → API-Keys) mit den Scopes events.website.read galleries.website.read members.website.read
# offices.website.read website.content.read (Banner, häufige Fragen, Blog)
# messages.website.contact (Kontaktformular → Posteingang „Stamm“ im Intern-Bereich, Modul „Nachrichten“)
WEBSITE_API_KEY=epk_...
# Von adapter-node für den CSRF-Origin-Check benötigt
ORIGIN=https://edelweisspiraten-bremen.de
# Öffentliche Adresse für kanonische Links, Open Graph, Sitemap, robots.txt, llms.txt (Standard: ORIGIN bzw. Anfrage-Adresse)
# PUBLIC_SITE_URL=https://edelweisspiraten-bremen.de
# Gzip für dynamische Antworten (Seiten, JSON, XML); 0 = aus (z. B. wenn der Reverse Proxy schon komprimiert)
# COMPRESS=1

# Hinter einem Reverse Proxy (nginx): Client-IP für das Rate-Limit je Besucher*in aus dem Proxy-Header lesen
# (adapter-node). Ohne diese Zeilen teilen sich alle Besucher*innen die IP des Proxys.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Besucherstatistik mit Umami (selbst gehostet, ohne Cookies): Adresse der Umami-Instanz, wie die Website sie
# serverseitig erreicht, und die Website-ID aus Umami (Einstellungen → Websites). Leer = keine Statistik.
# Der Browser lädt Skript und Ereignisse nur über /stats/… dieser Website (Proxy).
# UMAMI_URL=https://um.edelweisspiraten-bremen.de
# UMAMI_WEBSITE_ID=91706512-8343-4261-9cc1-fcf67bffd09e

# Bild-Cache des Proxys (Arbeitsspeicher): Größe in MB (0 = aus) und Dauer in Sekunden
# IMAGE_CACHE_MB=48
# IMAGE_CACHE_TTL_SEC=3600

# Kontaktformular (/kontakt): Anfragen gehen in den Posteingang des Intern-Bereichs (Scope oben).
# Nur RÜCKFALL bei Ausfall des Backends: Versand per SMTP an EINE feste Adresse. Ohne SMTP_HOST/SMTP_FROM/CONTACT_TO
# zeigt das Formular dann einen Hinweis auf die E-Mail-Adresse der Stammesführung.
CONTACT_TO=kontakt@edelweisspiraten-bremen.de
SMTP_HOST=
# 587 = STARTTLS (Standard), 465 = direktes TLS (SMTP_SECURE=true)
SMTP_PORT=587
# SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Absenderadresse (muss zum SMTP-Konto passen); Antworten gehen per Reply-To an die anfragende Person
SMTP_FROM=website@edelweisspiraten-bremen.de
