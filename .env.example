# Basis-URL des Intern-Bereichs (serverseitig erreichbar, ohne abschließenden Schrägstrich)
INTERN_API_URL=http://intern:3000
# API-Key mit den Scopes events.website.read galleries.website.read offices.website.read members.website.read
INTERN_API_KEY=epk_...
# Öffentliche Adresse der Website (Canonical-Links, Teilen)
PUBLIC_SITE_URL=https://edelweisspiraten-bremen.de
# Von adapter-node für den CSRF-Origin-Check benötigt
ORIGIN=https://edelweisspiraten-bremen.de
# Optional: Cache-Dauer der API-Antworten in Sekunden (Standard 60)
# INTERN_CACHE_TTL=60
# Optional: Größe des Bild-Caches in MB (Standard 100, 0 = aus)
# IMAGE_CACHE_MB=100
